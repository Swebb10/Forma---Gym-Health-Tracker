rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // The owner must prove control of this email through Firebase Authentication.
    // UI checks are only presentation; this rule enforces the administrator boundary.
    function superAdmin() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() == 'swebb1732@gmail.com';
    }
    function entitled(uid) {
      let m = get(/databases/$(database)/documents/members/$(uid)).data;
      return m.active == true && (
        (m.subscriptionStatus == 'trial' && request.time < m.createdAt + duration.value(30, 'd'))
        || (m.subscriptionStatus == 'active' && m.subscriptionEndsAt is timestamp && request.time < m.subscriptionEndsAt)
      );
    }
    function canWrite(uid) { return owner(uid) && (superAdmin() || entitled(uid)); }
    function validMember(d) {
      return d.keys().hasOnly(['email','active','subscriptionStatus','subscriptionEndsAt','notes','createdAt','updatedAt'])
        && text(d,'email',320) && d.active is bool
        && d.subscriptionStatus in ['trial','active']
        && (d.subscriptionStatus == 'trial' ? d.subscriptionEndsAt == null : d.subscriptionEndsAt is timestamp)
        && d.notes is string && d.notes.size() <= 1000 && audit();
    }
    match /members/{uid} {
      allow get: if owner(uid) || superAdmin();
      allow list: if superAdmin();
      allow create: if owner(uid) && validMember(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.subscriptionEndsAt == null && request.resource.data.notes == '';
      allow update: if validMember(request.resource.data) && (
        (superAdmin() && request.resource.data.email == resource.data.email)
        || (owner(uid) && request.resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','updatedAt']))
      );
      // No client may delete/recreate a profile to reset its trial.
      allow delete: if false;
    }
    match /settings/billing {
      allow read: if request.auth != null;
      allow create, update: if superAdmin()
        && request.resource.data.keys().hasOnly(['phone','holder','monthly','quarterly','yearly','updatedAt','updatedBy'])
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[678][0-9]{7}$')
        && text(request.resource.data,'holder',120)
        && request.resource.data.monthly is int && request.resource.data.monthly > 0 && request.resource.data.monthly <= 10000000
        && request.resource.data.quarterly is int && request.resource.data.quarterly > 0 && request.resource.data.quarterly <= 10000000
        && request.resource.data.yearly is int && request.resource.data.yearly > 0 && request.resource.data.yearly <= 10000000
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
    }
    match /subscriptionPayments/{id} {
      allow get: if superAdmin() || (request.auth != null && resource.data.memberId == request.auth.uid);
      allow list: if superAdmin() || (request.auth != null && resource.data.memberId == request.auth.uid);
      allow create: if superAdmin() && validPayment(request.resource.data, id);
      allow update, delete: if false;
    }
    function validPayment(d,id) {
      return d.keys().hasOnly(['memberId','email','plan','months','amount','reference','previousEnd','subscriptionEndsAt','verifiedAt','verifiedBy'])
        && text(d,'memberId',128) && text(d,'email',320)
        && ((d.plan == 'monthly' && d.months == 1) || (d.plan == 'quarterly' && d.months == 3) || (d.plan == 'yearly' && d.months == 12))
        && d.amount is int && d.amount > 0 && d.amount <= 10000000
        && d.reference is string && d.reference.matches('^[A-Z0-9-]{4,80}$')
        && (d.previousEnd == null || d.previousEnd is timestamp)
        && d.subscriptionEndsAt is timestamp && d.subscriptionEndsAt > request.time
        && d.verifiedAt == request.time && d.verifiedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/subscriptionPaymentReferences/$(d.reference)).data.paymentId == id
        && getAfter(/databases/$(database)/documents/subscriptionPaymentReferences/$(d.reference)).data.memberId == d.memberId
        && getAfter(/databases/$(database)/documents/members/$(d.memberId)).data.subscriptionEndsAt == d.subscriptionEndsAt;
    }
    match /subscriptionPaymentReferences/{reference} {
      allow read: if superAdmin();
      allow create: if superAdmin() && reference.matches('^[A-Z0-9-]{4,80}$')
        && request.resource.data.keys().hasOnly(['paymentId','memberId'])
        && text(request.resource.data,'paymentId',128) && text(request.resource.data,'memberId',128)
        && getAfter(/databases/$(database)/documents/subscriptionPayments/$(request.resource.data.paymentId)).data.reference == reference
        && getAfter(/databases/$(database)/documents/subscriptionPayments/$(request.resource.data.paymentId)).data.memberId == request.resource.data.memberId;
      allow update, delete: if false;
    }
    match /subscriptionAudit/{id} {
      allow read: if superAdmin();
      allow create: if superAdmin()
        && request.resource.data.keys().hasOnly(['memberId','email','reason','before','after','changedBy','changedAt'])
        && text(request.resource.data,'memberId',128) && text(request.resource.data,'email',320)
        && text(request.resource.data,'reason',500)
        && request.resource.data.before is map && request.resource.data.after is map
        && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time;
      allow update, delete: if false;
    }
    match /billingAudit/{id} {
      allow read: if superAdmin();
      allow create: if superAdmin()
        && request.resource.data.keys().hasOnly(['before','after','changedBy','changedAt'])
        && request.resource.data.before is map && request.resource.data.after is map
        && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time;
      allow update, delete: if false;
    }

    function text(d, key, max) { return d[key] is string && d[key].size() > 0 && d[key].size() <= max; }
    function optionalNumber(d, key, min, max) { let value = d.get(key, min); return value is number && value >= min && value <= max; }
    function date(d) { return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function audit() {
      let d = request.resource.data;
      return d.createdAt is timestamp && d.updatedAt == request.time
        && (resource == null ? d.createdAt == request.time : d.createdAt == resource.data.createdAt);
    }
    function nutritionNumbers(d) {
      return d is map && d.keys().hasOnly(['age','height','weight']) && d.keys().hasAll(['age','height','weight'])
        && d.age is int && d.age >= 1 && d.age <= 120
        && d.height is number && d.height >= 100 && d.height <= 250
        && d.weight is number && d.weight >= 30 && d.weight <= 300;
    }
    function validNutrition(n) {
      let p = n.preferences;
      let i = n.inputs;
      let s = n.sources;
      return n is map && n.keys().hasOnly(['version','preferences','inputs','targets','sources'])
        && n.version == 1 && p is map
        && p.keys().hasOnly(['goal','activity','source','sex','manual','specialCase'])
        && p.keys().hasAll(['goal','activity','source','sex','manual','specialCase'])
        && p.goal in ['bulk','recomp','cut','maintain']
        && p.activity in ['sedentary','light','moderate','high']
        && p.source in ['bio','manual'] && p.sex in ['male','female',''] && p.specialCase is bool
        && (p.manual == null || nutritionNumbers(p.manual))
        && (p.source != 'manual' || p.manual != null)
        && (i == null || (i is map && i.keys().hasOnly(['age','height','weight','sex'])
          && nutritionNumbers({'age':i.age,'height':i.height,'weight':i.weight}) && i.sex in ['male','female'] && i.sex == p.sex))
        && (n.targets == null || (i != null && i.age >= 18 && i.age <= 100 && !p.specialCase && nutritionTargets(n.targets)))
        && s is map && s.keys().hasOnly(['bioId','bioDate','measurementId','measurementDate'])
        && nullableId(s.bioId) && nullableId(s.measurementId) && nullableDate(s.bioDate) && nullableDate(s.measurementDate);
    }
    function nullableId(v) { return v == null || (v is string && v.size() > 0 && v.size() <= 128); }
    function nullableDate(v) { return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function nutritionTargets(d) {
      let energy = 4*d.protein + 4*d.carbs + 9*d.fat;
      return d is map && d.keys().hasOnly(['calories','protein','carbs','fat','resting','maintenance'])
        && d.calories is int && d.calories >= 1200 && d.calories <= 6000
        && d.protein is int && d.protein > 0 && d.protein <= 600
        && d.carbs is int && d.carbs >= 0 && d.carbs <= 1500
        && d.fat is int && d.fat > 0 && d.fat <= 300
        && d.resting is int && d.resting > 0 && d.resting <= 6000
        && d.maintenance is int && d.maintenance > 0 && d.maintenance <= 8000
        && energy >= d.calories-10 && energy <= d.calories+10;
    }
    // Private health profile. Billing administrators cannot read other users' health data.
    match /users/{uid} {
      allow get: if owner(uid);
      allow create, update: if canWrite(uid) && audit()
        && request.resource.data.keys().hasOnly(['nutrition','createdAt','updatedAt'])
        && validNutrition(request.resource.data.nutrition);
      allow list, delete: if false;
    }
    function exercises(d) { return d.exercises is list && d.exercises.size() > 0 && d.exercises.size() <= 100; }
    match /users/{uid}/routines/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if canWrite(uid) && audit()
        && request.resource.data.keys().hasOnly(['name','description','exercises','days','createdAt','updatedAt'])
        && text(request.resource.data,'name',100)
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && exercises(request.resource.data)
        && (!('days' in request.resource.data) || (request.resource.data.days is list && request.resource.data.days.size() > 0 && request.resource.data.days.size() <= 14));
    }
    match /users/{uid}/workouts/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if canWrite(uid) && audit()
        && request.resource.data.keys().hasOnly(['date','routineId','routineDayId','name','duration','notes','exercises','createdAt','updatedAt'])
        && date(request.resource.data) && text(request.resource.data,'name',100)
        && (request.resource.data.routineId == null || request.resource.data.routineId is string)
        && (request.resource.data.get('routineDayId',null) == null || request.resource.data.routineDayId is string)
        && request.resource.data.duration is int && request.resource.data.duration > 0 && request.resource.data.duration <= 1440
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
        && exercises(request.resource.data);
    }
    match /users/{uid}/measurements/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if canWrite(uid) && audit() && validMeasurements(request.resource.data);
    }
    function validMeasurements(d) {
      return date(d) && d.keys().hasOnly(['date','createdAt','updatedAt','biceps','chest','waist','thighs','calves','neck','shoulders','leftArmRelaxed','leftArmFlexed','rightArmRelaxed','rightArmFlexed','leftForearm','rightForearm','hips','leftThighHigh','leftThighMid','rightThighHigh','rightThighMid','leftCalf','rightCalf'])
        && d.keys().hasAny(['biceps','chest','waist','thighs','calves','neck','shoulders','leftArmRelaxed','leftArmFlexed','rightArmRelaxed','rightArmFlexed','leftForearm','rightForearm','hips','leftThighHigh','leftThighMid','rightThighHigh','rightThighMid','leftCalf','rightCalf'])
        && optionalNumber(d,'biceps',0.1,100)
        && optionalNumber(d,'chest',0.1,250)
        && optionalNumber(d,'waist',0.1,250)
        && optionalNumber(d,'thighs',0.1,150)
        && optionalNumber(d,'calves',0.1,100)
        && optionalNumber(d,'neck',0.1,100)
        && optionalNumber(d,'shoulders',0.1,250)
        && optionalNumber(d,'leftArmRelaxed',0.1,100)
        && optionalNumber(d,'leftArmFlexed',0.1,100)
        && optionalNumber(d,'rightArmRelaxed',0.1,100)
        && optionalNumber(d,'rightArmFlexed',0.1,100)
        && optionalNumber(d,'leftForearm',0.1,100)
        && optionalNumber(d,'rightForearm',0.1,100)
        && optionalNumber(d,'hips',0.1,250)
        && optionalNumber(d,'leftThighHigh',0.1,150)
        && optionalNumber(d,'leftThighMid',0.1,150)
        && optionalNumber(d,'rightThighHigh',0.1,150)
        && optionalNumber(d,'rightThighMid',0.1,150)
        && optionalNumber(d,'leftCalf',0.1,100)
        && optionalNumber(d,'rightCalf',0.1,100);
    }
    match /users/{uid}/bioimpedance/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if canWrite(uid) && audit() && validBio(request.resource.data);
    }
    function validBio(d) {
      return d.keys().hasOnly(['date','time','gender','age','height','weight','bodyFat','bmi','visceralFat','water','skeletalMuscle','boneMass','bmr','normalMuscle','normalFat','normalSkeleton','normalOther','fatMass','fatIndex','leanMass','fatLossIndex','fatProportion','leftArmKg','leftArmPct','rightArmKg','rightArmPct','torsoKg','torsoPct','leftLegKg','leftLegPct','rightLegKg','rightLegPct','createdAt','updatedAt'])
        && d.keys().hasAll(['date','time','gender','age','height','weight','bodyFat','bmi'])
        && date(d) && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.gender in ['male','female','other','unspecified']
        && d.age is int && d.age >= 1 && d.age <= 120
        && optionalNumber(d,'height',30,250)
        && optionalNumber(d,'weight',1,500)
        && optionalNumber(d,'bodyFat',0,100)
        && optionalNumber(d,'bmi',1,200)
        && optionalNumber(d,'visceralFat',0,100)
        && optionalNumber(d,'water',0,100)
        && optionalNumber(d,'skeletalMuscle',0,100)
        && optionalNumber(d,'boneMass',0,30)
        && optionalNumber(d,'bmr',0,10000)
        && optionalNumber(d,'normalMuscle',0,100)
        && optionalNumber(d,'normalFat',0,100)
        && optionalNumber(d,'normalSkeleton',0,100)
        && optionalNumber(d,'normalOther',0,100)
        && optionalNumber(d,'fatMass',0,400)
        && optionalNumber(d,'fatIndex',0,200)
        && optionalNumber(d,'leanMass',0,400)
        && optionalNumber(d,'fatLossIndex',-100,200)
        && optionalNumber(d,'fatProportion',0,100)
        && optionalNumber(d,'leftArmKg',0,200)
        && optionalNumber(d,'leftArmPct',0,100)
        && optionalNumber(d,'rightArmKg',0,200)
        && optionalNumber(d,'rightArmPct',0,100)
        && optionalNumber(d,'torsoKg',0,200)
        && optionalNumber(d,'torsoPct',0,100)
        && optionalNumber(d,'leftLegKg',0,200)
        && optionalNumber(d,'leftLegPct',0,100)
        && optionalNumber(d,'rightLegKg',0,200)
        && optionalNumber(d,'rightLegPct',0,100);
    }
    match /{document=**} { allow read, write: if false; }
  }
}

